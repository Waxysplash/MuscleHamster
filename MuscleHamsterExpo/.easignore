# EAS Build ignore file
# This overrides .gitignore for EAS uploads
# We INCLUDE GoogleService-Info.plist here (not ignored) so it gets uploaded to EAS

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# NOTE: GoogleService-Info.plist and google-services.json are NOT ignored here
# They need to be uploaded to EAS for Firebase to work

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# git
.git/
