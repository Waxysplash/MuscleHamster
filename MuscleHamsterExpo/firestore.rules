rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user owns this document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Check if user is in the users array (for friend relationships)
    function isParticipant(usersArray) {
      return isAuthenticated() && request.auth.uid in usersArray;
    }

    // ===========================================
    // USER DATA - Only owner can read/write
    // ===========================================

    // User profiles
    match /users/{userId} {
      // Owner can read their full profile
      // Other authenticated users can only read profiles (for friend features)
      // Note: Sensitive fields should not be stored here - use a separate private subcollection
      allow read: if isOwner(userId) ||
        (isAuthenticated() && resource.data.profileVisibility != 'PRIVATE');

      // Only owner can write their own profile
      allow write: if isOwner(userId);
    }

    // User stats (streaks, points, etc.)
    match /userStats/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User inventory (purchased items)
    match /inventory/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Exercise journals
    match /exerciseJournals/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User favorites
    match /userFavorites/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Custom workouts
    match /customWorkouts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Saved workout routines (grouped workouts with custom names)
    match /savedRoutines/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ===========================================
    // WEEKLY SCHEDULE (Planner Feature)
    // ===========================================

    // Weekly schedules
    // Document ID format: {userId}_{weekStartDate} e.g., "abc123_2026-03-17"
    match /weeklySchedules/{scheduleId} {
      // Helper: Check if document ID starts with user's UID
      // This allows reads even when document doesn't exist yet
      function isScheduleOwner() {
        return scheduleId.matches(request.auth.uid + '_.*');
      }

      // User can read their own schedules
      // Check ID prefix (for direct access) OR userId field (for queries)
      allow read: if isAuthenticated() &&
        (isScheduleOwner() || resource.data.userId == request.auth.uid);

      // User can create schedules with their own userId
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // User can update/delete their own schedules
      allow update, delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ===========================================
    // SOCIAL FEATURES - Shared between users
    // ===========================================

    // Friend relationships
    // Document ID format: {userId1}_{userId2} (sorted alphabetically)
    match /friends/{friendId} {
      // Both participants can read the relationship
      allow read: if isAuthenticated() &&
        (request.auth.uid in resource.data.users);

      // Create: Either user can initiate
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.users &&
        request.resource.data.initiatedBy == request.auth.uid;

      // Update: Both participants can update (accept, update streak)
      // Protect immutable fields: users array, initiatedBy, createdAt
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.users &&
        request.resource.data.users == resource.data.users &&
        request.resource.data.initiatedBy == resource.data.initiatedBy &&
        request.resource.data.createdAt == resource.data.createdAt;

      // Delete: Either participant can remove/decline
      allow delete: if isAuthenticated() &&
        request.auth.uid in resource.data.users;
    }

    // Nudges
    match /nudges/{nudgeId} {
      // Sender and recipient can read
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.fromUserId ||
         request.auth.uid == resource.data.toUserId);

      // Only sender can create, and must set fromUserId correctly
      allow create: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid;

      // Only recipient can update (mark as read)
      // Protect immutable fields: fromUserId, toUserId, message, sentAt/createdAt
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.toUserId &&
        request.resource.data.fromUserId == resource.data.fromUserId &&
        request.resource.data.toUserId == resource.data.toUserId &&
        request.resource.data.message == resource.data.message;

      // Sender or recipient can delete
      allow delete: if isAuthenticated() &&
        (request.auth.uid == resource.data.fromUserId ||
         request.auth.uid == resource.data.toUserId);
    }

    // Invite codes
    match /invites/{inviteCode} {
      // Only owner can read their own invite code details
      // Lookup by code is done via the document ID, so we allow read if authenticated
      // but the code itself must be known (prevents enumeration)
      allow read: if isAuthenticated();

      // Only owner can create with their own ownerId
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.createdAt == request.time;

      // Only owner can update their invite (protect ownerId, createdAt)
      // usedBy tracking should happen server-side via Cloud Functions
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.ownerId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.createdAt == resource.data.createdAt;

      // Only owner can delete
      allow delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
    }

    // ===========================================
    // CATCH-ALL: Deny everything else
    // ===========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
